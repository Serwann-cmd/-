#include <iostream>
#include <vector>
#include <string>
#include <conio.h>
#include <windows.h>
#include <cstdlib>
#include <ctime>

using namespace std;

const int WIDTH = 60;
const int HEIGHT = 20;
const int PADDLE_H = 4;

void setCursorPos(int x, int y) {
    static HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
    COORD coord = { (SHORT)x, (SHORT)y };
    SetConsoleCursorPosition(h, coord);
}

int main() {
    srand((unsigned)time(nullptr));

    int playerY = HEIGHT/2 - PADDLE_H/2;
    int aiY = HEIGHT/2 - PADDLE_H/2;
    int ballX = WIDTH/2;
    int ballY = HEIGHT/2;
    int dirX = (rand()%2) ? 1 : -1;
    int dirY = (rand()%2) ? 1 : -1;
    int playerScore = 0, aiScore = 0;

    CONSOLE_CURSOR_INFO cursorInfo;
    cursorInfo.dwSize = 1;
    cursorInfo.bVisible = FALSE;
    SetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE), &cursorInfo);

    for (int i = 0; i < HEIGHT; ++i) cout << string(WIDTH, ' ') << '\n';

    bool running = true;
    while (running) {
        if (_kbhit()) {
            int ch = _getch();
            if (ch == 'w' || ch == 'W') {
                if (playerY > 1) playerY--;
            } else if (ch == 's' || ch == 'S') {
                if (playerY + PADDLE_H < HEIGHT-1) playerY++;
            } else if (ch == 'q' || ch == 'Q') {
                running = false;
                break;
            }
        }

        if (ballY < aiY + PADDLE_H/2 && aiY > 1) aiY--;
        else if (ballY > aiY + PADDLE_H/2 && aiY + PADDLE_H < HEIGHT-1) aiY++;

        ballX += dirX;
        ballY += dirY;

        if (ballY <= 0) { ballY = 0; dirY = 1; }
        if (ballY >= HEIGHT-1) { ballY = HEIGHT-1; dirY = -1; }

        if (ballX == 2) {
            if (ballY >= playerY && ballY < playerY + PADDLE_H) {
                dirX = 1;
                int hitPos = ballY - playerY;
                if (hitPos == 0) dirY = -1;
                else if (hitPos == PADDLE_H-1) dirY = 1;
            }
        }

        if (ballX == WIDTH-3) {
            if (ballY >= aiY && ballY < aiY + PADDLE_H) {
                dirX = -1;
                int hitPos = ballY - aiY;
                if (hitPos == 0) dirY = -1;
                else if (hitPos == PADDLE_H-1) dirY = 1;
            }
        }

        if (ballX < 0) {
            aiScore++;
            ballX = WIDTH/2; ballY = HEIGHT/2;
            dirX = 1; dirY = (rand()%2)?1:-1;
        } else if (ballX > WIDTH-1) {
            playerScore++;
            ballX = WIDTH/2; ballY = HEIGHT/2;
            dirX = -1; dirY = (rand()%2)?1:-1;
        }

        vector<string> screen(HEIGHT, string(WIDTH, ' '));

        for (int x = 0; x < WIDTH; ++x) {
            screen[0][x] = '-';
            screen[HEIGHT-1][x] = '-';
        }
        for (int y = 0; y < HEIGHT; ++y) {
            screen[y][0] = '|';
            screen[y][WIDTH-1] = '|';
        }

        for (int i = 0; i < PADDLE_H; ++i) {
            screen[playerY + i][1] = '#';
        }

        for (int i = 0; i < PADDLE_H; ++i) {
            screen[aiY + i][WIDTH-2] = '#';
        }

        if (ballY >= 0 && ballY < HEIGHT && ballX >= 0 && ballX < WIDTH)
            screen[ballY][ballX] = 'O';

        string score = " Player: " + to_string(playerScore) + "   AI: " + to_string(aiScore) + "   (W/S - move, Q - quit)";
        for (size_t i = 0; i < score.size() && i + 2 < screen[0].size(); ++i) {
            screen[0][2 + i] = score[i];
        }

        setCursorPos(0, 0);
        for (int y = 0; y < HEIGHT; ++y) {
            cout << screen[y] << '\n';
        }

        Sleep(50);
    }

    cursorInfo.bVisible = TRUE;
    SetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE), &cursorInfo);

    cout << "\nВыход. Спасибо за игру!\n";
    return 0;
}